<UserControl x:Class="TestAutomation.UI.Wpf.Views.Editors.HttpStepEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:TestAutomation.UI.Wpf.Helpers"
             xmlns:core="clr-namespace:TestAutomationEngine.Core;assembly=ApiAutoTest"
             xmlns:converters="clr-namespace:TestAutomation.UI.Wpf.Converters"
             xmlns:auth="clr-namespace:TestAutomation.UI.Wpf.Views.Editors"
             xmlns:editors="clr-namespace:TestAutomation.UI.Wpf.Views.Editors"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <UserControl.Resources>
        <!-- Enum DataProviders for Assertions & Extractions -->
        <ObjectDataProvider x:Key="AssertionBehaviorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:AssertionBehavior"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="OperatorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:Operator"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ExtractionTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:ExtractionType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Auth Converter -->
        <converters:AuthTypeConverter x:Key="AuthTypeConverter"/>

        <!-- Auth Template Selector -->
        <editors:AuthTypeTemplateSelector x:Key="AuthTemplateSelector">
            <editors:AuthTypeTemplateSelector.NoneTemplate>
                <DataTemplate>
                    <TextBlock Text="No authentication" Foreground="Gray"/>
                </DataTemplate>
            </editors:AuthTypeTemplateSelector.NoneTemplate>
            <editors:AuthTypeTemplateSelector.ApiKeyTemplate>
                <DataTemplate DataType="{x:Type core:ApiKeyStrategy}">
                    <auth:ApiKeyAuthEditor/>
                </DataTemplate>
            </editors:AuthTypeTemplateSelector.ApiKeyTemplate>
            <editors:AuthTypeTemplateSelector.BearerTokenTemplate>
                <DataTemplate DataType="{x:Type core:BearerTokenStrategy}">
                    <auth:BearerTokenAuthEditor/>
                </DataTemplate>
            </editors:AuthTypeTemplateSelector.BearerTokenTemplate>
            <editors:AuthTypeTemplateSelector.OAuth2ClientCredentialsTemplate>
                <DataTemplate DataType="{x:Type core:OAuth2ClientCredentials}">
                    <auth:OAuth2ClientCredentialsEditor/>
                </DataTemplate>
            </editors:AuthTypeTemplateSelector.OAuth2ClientCredentialsTemplate>
            <editors:AuthTypeTemplateSelector.WindowsIntegratedTemplate>
                <DataTemplate DataType="{x:Type core:WindowsIntegratedStrategy}">
                    <auth:WindowsIntegratedAuthEditor/>
                </DataTemplate>
            </editors:AuthTypeTemplateSelector.WindowsIntegratedTemplate>
        </editors:AuthTypeTemplateSelector>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top: Name, Method, URL -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Name" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" 
                          ItemsSource="{x:Static helpers:HttpMethodHelper.SupportedMethods}" 
                          SelectedItem="{Binding Method}" 
                          DisplayMemberPath="Method" 
                          Margin="0,0,8,0" 
                          Padding="4"/>
                <TextBox Grid.Column="1" 
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="4"/>
            </Grid>
        </StackPanel>

        <!-- Tab Control for Headers, Body, Auth, Assertions, Extractions -->
        <TabControl Grid.Row="1">
            <TabItem Header="Headers">
                <DataGrid ItemsSource="{Binding Headers}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="True" 
                          HeadersVisibility="Column"
                          MinHeight="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Body">
                <TextBox Text="{Binding BodyString, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         MinHeight="150"/>
            </TabItem>

            <TabItem Header="Auth">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Authentication Type:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding Authentication, Converter={StaticResource AuthTypeConverter}}" 
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="None" Tag="{x:Null}"/>
                            <ComboBoxItem Content="API Key" Tag="{x:Type core:ApiKeyStrategy}"/>
                            <ComboBoxItem Content="Bearer Token" Tag="{x:Type core:BearerTokenStrategy}"/>
                            <ComboBoxItem Content="OAuth 2.0 (Client Credentials)" Tag="{x:Type core:OAuth2ClientCredentials}"/>
                            <ComboBoxItem Content="Windows Integrated" Tag="{x:Type core:WindowsIntegratedStrategy}"/>
                        </ComboBox>
                    </StackPanel>
                    <ContentControl Grid.Row="1" Content="{Binding Authentication}"
                                    ContentTemplateSelector="{StaticResource AuthTemplateSelector}"
                                    Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Assertions">
                <DataGrid ItemsSource="{Binding Assertions}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="True"
                          HeadersVisibility="Column"
                          MinHeight="150">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="Behavior" 
                            ItemsSource="{Binding Source={StaticResource AssertionBehaviorValues}}" 
                            SelectedItemBinding="{Binding Behavior}" Width="100"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="150"/>
                        <DataGridComboBoxColumn Header="Operator" 
                            ItemsSource="{Binding Source={StaticResource OperatorValues}}" 
                            SelectedItemBinding="{Binding Operator}" Width="120"/>
                        <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedValue}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Extractions">
                <DataGrid ItemsSource="{Binding Extractions}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="True"
                          HeadersVisibility="Column"
                          MinHeight="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150"/>
                        <DataGridTextColumn Header="Target Variable" Binding="{Binding TargetVariable}" Width="150"/>
                        <DataGridComboBoxColumn Header="Type" 
                            ItemsSource="{Binding Source={StaticResource ExtractionTypeValues}}" 
                            SelectedItemBinding="{Binding Type}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>