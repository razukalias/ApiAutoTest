<UserControl x:Class="TestAutomation.UI.Wpf.Views.Editors.HttpStepEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:TestAutomation.UI.Wpf.Helpers"
             xmlns:core="clr-namespace:TestAutomationEngine.Core;assembly=ApiAutoTest"
             xmlns:converters="clr-namespace:TestAutomation.UI.Wpf.Converters"
             xmlns:auth="clr-namespace:TestAutomation.UI.Wpf.Views.Editors"
             xmlns:editors="clr-namespace:TestAutomation.UI.Wpf.Views.Editors"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             DataContextChanged="HttpStepEditor_DataContextChanged">

    <UserControl.Resources>
        <!-- Enum DataProviders for Assertions & Extractions -->
        <ObjectDataProvider x:Key="AssertionBehaviorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:AssertionBehavior"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="OperatorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:Operator"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ExtractionTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:ExtractionType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Auth Converter -->
        <converters:AuthTypeConverter x:Key="AuthTypeConverter"/>

        <!-- Auth Template Selector -->
        <editors:AuthTypeTemplateSelector x:Key="AuthTemplateSelector">
            <editors:AuthTypeTemplateSelector.NoneTemplate>
                <DataTemplate>
                    <TextBlock Text="No authentication" Foreground="Gray"/>
                </DataTemplate>
            </editors:AuthTypeTemplateSelector.NoneTemplate>
            <editors:AuthTypeTemplateSelector.ApiKeyTemplate>
                <DataTemplate DataType="{x:Type core:ApiKeyStrategy}">
                    <auth:ApiKeyAuthEditor/>
                </DataTemplate>
            </editors:AuthTypeTemplateSelector.ApiKeyTemplate>
            <editors:AuthTypeTemplateSelector.BearerTokenTemplate>
                <DataTemplate DataType="{x:Type core:BearerTokenStrategy}">
                    <auth:BearerTokenAuthEditor/>
                </DataTemplate>
            </editors:AuthTypeTemplateSelector.BearerTokenTemplate>
            <editors:AuthTypeTemplateSelector.OAuth2ClientCredentialsTemplate>
                <DataTemplate DataType="{x:Type core:OAuth2ClientCredentials}">
                    <auth:OAuth2ClientCredentialsEditor/>
                </DataTemplate>
            </editors:AuthTypeTemplateSelector.OAuth2ClientCredentialsTemplate>
            <editors:AuthTypeTemplateSelector.WindowsIntegratedTemplate>
                <DataTemplate DataType="{x:Type core:WindowsIntegratedStrategy}">
                    <auth:WindowsIntegratedAuthEditor/>
                </DataTemplate>
            </editors:AuthTypeTemplateSelector.WindowsIntegratedTemplate>
        </editors:AuthTypeTemplateSelector>

        <!-- Templates for preview -->
        <DataTemplate x:Key="JsonPreviewTemplate">
            <TreeView x:Name="PreviewJsonTree" 
                  SelectedItemChanged="PreviewJsonTree_SelectedItemChanged"
                  MaxHeight="250" BorderBrush="Gray" BorderThickness="1"/>
        </DataTemplate>

        <DataTemplate x:Key="HeadersPreviewTemplate">
            <DataGrid AutoGenerateColumns="False" SelectionChanged="HeadersGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Key}" Width="*"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}"  Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>

        <DataTemplate x:Key="PlainTextPreviewTemplate">
            <TextBox Text="{Binding}" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        </DataTemplate>

        <!-- Source selector -->
        <editors:ExtractionSourceTemplateSelector x:Key="ExtractionSourceTemplateSelector"
        JsonTemplate="{StaticResource JsonPreviewTemplate}"
        HeadersTemplate="{StaticResource HeadersPreviewTemplate}"
        PlainTextTemplate="{StaticResource PlainTextPreviewTemplate}"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top: Name, Method, URL -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Name" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" 
                          ItemsSource="{x:Static helpers:HttpMethodHelper.SupportedMethods}" 
                          SelectedItem="{Binding Method}" 
                          DisplayMemberPath="Method" 
                          Margin="0,0,8,0" 
                          Padding="4"/>
                <TextBox Grid.Column="1" 
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="4"/>
            </Grid>
        </StackPanel>

        <!-- Tab Control for Headers, Body, Auth, Assertions, Extractions -->
        <TabControl Grid.Row="1">
            <TabItem Header="Headers">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="Add Header" Click="AddHeader_Click" Margin="0,0,0,5"/>
                    <DataGrid Grid.Row="1" x:Name="HeadersGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Body">
                <TextBox Text="{Binding BodyString, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         MinHeight="150"/>
            </TabItem>

            <TabItem Header="Auth">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Authentication Type:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding Authentication, Converter={StaticResource AuthTypeConverter}}" 
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="None" Tag="{x:Null}"/>
                            <ComboBoxItem Content="API Key" Tag="{x:Type core:ApiKeyStrategy}"/>
                            <ComboBoxItem Content="Bearer Token" Tag="{x:Type core:BearerTokenStrategy}"/>
                            <ComboBoxItem Content="OAuth 2.0 (Client Credentials)" Tag="{x:Type core:OAuth2ClientCredentials}"/>
                            <ComboBoxItem Content="Windows Integrated" Tag="{x:Type core:WindowsIntegratedStrategy}"/>
                        </ComboBox>
                    </StackPanel>
                    <ContentControl Grid.Row="1" Content="{Binding Authentication}"
                                    ContentTemplateSelector="{StaticResource AuthTemplateSelector}"
                                    Margin="0,10,0,0"/>
                </Grid>
            </TabItem>


            <TabItem Header="Assertions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Add button -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                        <RowDefinition Height="Auto"/>
                        <!-- Source / controls row -->
                        <RowDefinition Height="Auto"/>
                        <!-- JSON tree picker -->
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Add Assertion"
                Click="AddAssertion_Click" Margin="0,0,0,5"/>

                    <DataGrid Grid.Row="1" x:Name="AssertionsGrid"
                  ItemsSource="{Binding Assertions}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  HeadersVisibility="Column"
                  MinHeight="120"
                  SelectionChanged="AssertionsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Behavior"
                    ItemsSource="{Binding Source={StaticResource AssertionBehaviorValues}}"
                    SelectedItemBinding="{Binding Behavior}" Width="100"/>
                            <DataGridTextColumn Header="Source"
                    Binding="{Binding SourceType}" Width="120"
                    IsReadOnly="True"/>
                            <DataGridTextColumn Header="Path / Variable"
                    Binding="{Binding Path}" Width="160"/>
                            <DataGridComboBoxColumn Header="Operator"
                    ItemsSource="{Binding Source={StaticResource OperatorValues}}"
                    SelectedItemBinding="{Binding Operator}" Width="120"/>
                            <DataGridTextColumn Header="Expected"
                    Binding="{Binding ExpectedValue}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Row 2: Source picker controls (same layout as Extractions) -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pick from:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2"
                      x:Name="AssertionSourceCombo"
                      SelectedIndex="0"
                      SelectionChanged="AssertionSourceCombo_SelectionChanged">
                            <ComboBoxItem Content="Response Body"/>
                            <ComboBoxItem Content="Response Headers"/>
                            <ComboBoxItem Content="Request Body"/>
                            <ComboBoxItem Content="Status Code"/>
                        </ComboBox>
                    </Grid>

                    <!-- Row 3: JSON tree picker (same control reused from Extractions) -->
                    <TreeView x:Name="AssertionJsonTreeView"
                  Grid.Row="3"
                  SelectedItemChanged="AssertionJsonTreeView_SelectedItemChanged"
                  MaxHeight="200"
                  Margin="0,4,0,0"
                  BorderBrush="Gray"
                  BorderThickness="1"/>
                </Grid>
            </TabItem>
            <TabItem Header="Extractions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- extraction rules grid -->
                        <RowDefinition Height="Auto"/>
                        <!-- source / variable dropdowns -->
                        <RowDefinition Height="*"/>
                        <!-- JSON tree preview -->
                    </Grid.RowDefinitions>

                    <!-- Extraction rules DataGrid (unchanged) -->
                    <DataGrid x:Name="ExtractionDataGrid" Grid.Row="0"
                  ItemsSource="{Binding Extractions}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  HeadersVisibility="Column"
                  MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source Type" Binding="{Binding SourceType}" Width="120"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150"/>
                            
                            <DataGridTextColumn Header="Target Variable" Binding="{Binding TargetVariable}" Width="150"/>
                            <DataGridComboBoxColumn Header="Type" 
                    ItemsSource="{Binding Source={StaticResource ExtractionTypeValues}}" 
                    SelectedItemBinding="{Binding Type}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Row 1: Controls -->
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Source:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" Name="SourceTypeCombo" SelectedIndex="0"
                      SelectionChanged="SourceTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="Response Body"/>
                            <ComboBoxItem Content="Response Headers"/>
                            <ComboBoxItem Content="Request Body"/>
                            <ComboBoxItem Content="Status Code"/>
                        </ComboBox>

                        <TextBlock Grid.Column="4" Text="Variable:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="6" Name="VariableCombo" IsEditable="True"
                      SelectionChanged="VariableCombo_SelectionChanged"/>
                    </Grid>

                    <!-- Row 2: JSON Tree Viewer (appears for JSON sources) -->
                    <TreeView x:Name="JsonTreeView" Grid.Row="2"
                  SelectedItemChanged="JsonTreeView_SelectedItemChanged"
                  MaxHeight="250" BorderBrush="Gray" BorderThickness="1"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>